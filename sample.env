# Sample environment file for the dashboard.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# this sample is tracked, so it must never contain real credentials.
#
#   cp sample.env .env
#
# The attribution, standard, and strategy modules do not read this file.
# Only the dashboard under `dashboard/` and the import command
# `script/import_to_database.py` consume it.

# ---------------------------------------------------------------------------
# Data source mode
# ---------------------------------------------------------------------------
# false : read the committed CSV and JSON files under modules/*/ directly.
#         No database required. This is the mode used for the cloud demo and
#         for any checkout that has not run the import command.
# true  : read from the PostgreSQL database configured below. Run
#         `uv run python script/import_to_database.py` first to populate it.
DATABASE=false

# ---------------------------------------------------------------------------
# PostgreSQL connection, used only when DATABASE=true
# ---------------------------------------------------------------------------
PG_HOST=your-database-host.example.com
PG_PORT=5432
PG_DATABASE=mta_data
PG_USER=your_database_user
PG_PASSWORD=your_database_password

# disable | allow | prefer | require | verify-ca | verify-full
PG_SSLMODE=prefer
