# Sample environment file for the dashboard.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# this sample is tracked, so it must never contain real credentials.
#
#   cp sample.env .env
#
# The attribution, standard, and strategy modules do not read this file.
# The Flask backend, its shared dashboard configuration, and the import command
# `script/import_to_database.py` consume it.

# ---------------------------------------------------------------------------
# Data source mode
# ---------------------------------------------------------------------------
# false : read the committed CSV and JSON files under modules/*/ directly.
#         No database required. This is the mode used for the cloud demo and
#         for any checkout that has not run the import command.
# true  : read from the PostgreSQL database configured below. Run
#         `uv run python script/import_to_database.py` first to populate it.
DATABASE=false

# The local server binds only to this interface. The team-server deployment
# keeps loopback and places an authenticated TLS reverse proxy in front.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# Server deployments set this to true so the browser cannot rewrite protected
# runtime configuration. Keep it false for an editable local checkout.
DASHBOARD_CONFIG_READ_ONLY=false

# Flask-specific aliases. The backend falls back to DASHBOARD_HOST/PORT when
# these are absent, so existing local files need no migration.
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8501

# Optional directory produced by MTA-SIM's CSV mode. When set, Campaigns and
# Budget Manager read its unchanged CSV files plus simulation_research.json.
# MTA_SIM_DATA_DIR=D:/research/mta-sim-10k

# ---------------------------------------------------------------------------
# PostgreSQL connection, used only when DATABASE=true
# ---------------------------------------------------------------------------
PG_HOST=your-database-host.example.com
PG_PORT=5432
PG_DATABASE=mta_data
PG_USER=your_database_user
PG_PASSWORD=your_database_password

# disable | allow | prefer | require | verify-ca | verify-full
PG_SSLMODE=prefer
