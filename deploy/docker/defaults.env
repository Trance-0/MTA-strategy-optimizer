# Application defaults for the local two-container stack.
#
# This file is tracked, so it must never contain a credential. It exists so
# the stack starts and serves real data on a clean checkout with no `.env` at
# the repository root: `DATABASE=false` reads the committed CSV and JSON files
# under `modules/`, which need no database and no secrets.
#
# `compose.yaml` lists this file first and the repository root's `.env` second.
# Compose applies them in order, so any key set there wins over the value here,
# and a key it does not mention keeps this default. Editing this file changes
# the fallback for every checkout; to change your own, edit the root `.env`.

# false: read the committed module files. true: read PostgreSQL, which then
# requires every PG_* value below to be set in the root `.env`.
DATABASE=false

# Empty rather than absent, so `database_settings()` reports which variable is
# missing and names sample.env, instead of the container failing on a
# KeyError with no remedy in the message.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=prefer

# The browser may rewrite runtime configuration in this local test stack; a
# server deployment sets this true so it cannot.
DASHBOARD_CONFIG_READ_ONLY=false

# No optional MTA-SIM research run is mounted by default, so the research views
# fall back to the committed fixtures. A host path set in the root `.env` will
# not resolve inside the container unless it is also mounted there.
MTA_SIM_DATA_DIR=
