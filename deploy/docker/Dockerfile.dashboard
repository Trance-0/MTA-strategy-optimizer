# syntax=docker/dockerfile:1.7
#
# The Vue client alone, for the local two-container test stack.
#
# `npm run build` is the unchanged local build, the one whose client fetches
# `/api/dashboard` from the service beside it — not `--mode static`, which bakes
# a snapshot in and would make the running Flask service unreachable from the
# browser. NGINX serves the result and forwards `/api` to the service image, so
# the client sees one origin exactly as it does behind Vite's dev proxy.
#
# Build context is the repository root, so the root `.dockerignore` applies.

FROM node:22.23.0-bookworm-slim AS client
ARG BUILD_COMMIT=unknown
ENV BUILD_COMMIT=${BUILD_COMMIT}
WORKDIR /workspace/dashboard
COPY VERSION /workspace/VERSION
COPY dashboard/package.json dashboard/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY script/import_ontology_review_fixtures.mjs /workspace/script/import_ontology_review_fixtures.mjs
COPY docs/en/strategy-evaluation/asin-gmv-nn-v1/results/demo_mlp_extended27.json \
    /workspace/docs/en/strategy-evaluation/asin-gmv-nn-v1/results/demo_mlp_extended27.json
COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=client /workspace/dashboard/dist /usr/share/nginx/html
EXPOSE 80
