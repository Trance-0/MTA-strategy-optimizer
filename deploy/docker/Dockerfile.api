# syntax=docker/dockerfile:1.7
#
# The Flask service alone, for the local two-container test stack.
#
# `deploy/appstack/Dockerfile` builds one image that serves the API and the
# built client together, because a Kubernetes deployment is cheaper as one
# service on one port. This image is the same Python runtime with the client
# stage removed: `dashboard/dist` is never copied in, so `client_dist_directory()`
# returns None and the service registers its API routes only. The Vue client is
# the separate image beside this one.
#
# Build context is the repository root, so the root `.dockerignore` applies.

FROM python:3.12.11-slim-bookworm AS runtime
ARG BUILD_COMMIT=unknown
COPY --from=ghcr.io/astral-sh/uv:0.12.2 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PROJECT_COMMIT=${BUILD_COMMIT} \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /application

# Install the locked environment before the sources, so editing a Python file
# does not invalidate the dependency layer.
COPY pyproject.toml uv.lock ./
COPY VERSION ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra backend --no-dev --no-install-project

COPY backend/ backend/
COPY dashboard/config.py dashboard/models.py dashboard/
COPY modules/ modules/
COPY script/ script/

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin app \
    && chown -R app:app /application

# A pipeline stage started from Budget Manager runs `uv run python ...`, and uv
# initializes a cache under HOME before it runs anything. The service account
# has no home directory, so without these the three stages the jobs API
# advertises as available all fail at launch with "Failed to initialize cache
# at /nonexistent/.cache/uv". /tmp is the one writable path in the production
# posture this image mirrors.
#
# These are set after `uv sync`, not beside the other ENV lines above: the
# build runs as root, so an earlier UV_CACHE_DIR would leave a root-owned
# /tmp/uv-cache baked into the image and the app user would be denied the
# directory it was given to fix the original problem.
ENV HOME=/tmp \
    UV_CACHE_DIR=/tmp/uv-cache

USER 10001:10001
EXPOSE 8501

CMD ["gunicorn", "--bind", "0.0.0.0:8501", "--workers", "1", "--threads", "4", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "backend.wsgi:application"]
