# Copy this file to deploy/.env and replace every REQUIRED value.
# Keep deploy/.env out of Git and transfer it only over a protected channel.

# GitHub sends the push webhook. Use owner/repository without a URL.
GITHUB_REPOSITORY=Trance-0/MTA-strategy-optimizer
GITHUB_BRANCH=main
# REQUIRED: at least 32 URL-safe characters. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Gitea is the only source the deployment server clones and fetches.
# The URL must not contain credentials.
GITEA_REPO_URL=https://gitea.example.com/owner/MTA-strategy-optimizer.git
GITEA_BRANCH=main

# Choose https or ssh.
GITEA_AUTH_MODE=https
# HTTPS mode: use a read-only access token, not an account password.
GITEA_USERNAME=
GITEA_TOKEN=
# SSH mode: paths may be absolute or relative to this deploy directory.
# Supply both files; the installer does not trust an ssh-keyscan result.
GITEA_SSH_PRIVATE_KEY_FILE=
GITEA_SSH_KNOWN_HOSTS_FILE=

# Both listeners default to loopback for a TLS reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9000

# Public addresses printed in the final operator instructions.
# Leave blank when the service is reachable only by its private address.
PUBLIC_DASHBOARD_URL=
PUBLIC_WEBHOOK_URL=

# Gitea mirror timing. The defaults tolerate the expected five-minute delay.
MIRROR_POLL_SECONDS=10
MIRROR_WAIT_SECONDS=600
MIRROR_RETRY_SECONDS=120
# Maximum duration of one Gitea probe or clone before it is cancelled.
GITEA_REQUEST_TIMEOUT_SECONDS=45
RELEASE_RETENTION=3

# Dashboard data source. File mode requires no database.
DATABASE=false
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=prefer

# Pinned downloads are checksum-verified by deploy/run.sh.
NODE_VERSION=22.23.2
WEBHOOK_VERSION=2.8.3
