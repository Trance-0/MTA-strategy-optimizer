# Keep deterministic source, documentation, data, and generated baselines stable
# across Windows and Unix worktrees.
#
# `.bat` is the exception that must be CRLF. cmd.exe seeks a `goto`/`call`
# label by byte offset and re-reads the file as it goes, and in an LF-only
# script that seek can land mid-line and report "cannot find the batch label"
# for a label that is plainly there. It depends on the offsets, so an LF file
# that works today breaks when an edit above the label changes its length --
# which is exactly what happened to `deploy/docker/run.bat` when `pull` mode
# was added to it.
*.bat text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.drawio text eol=lf
*.svg text eol=lf

# Canonical cross-repository fixture bytes are checksum-pinned release inputs.
dashboard/fixtures/ontology_review/canonical_r5_v3/*.json -text

# Submodule content belongs to the submodule, so this repository must not
# renormalize its bytes. The Gitea mirror materializes each pinned submodule
# with `git read-tree`, which copies blobs by object identifier and applies no
# filter, so a submodule blob committed with CRLF enters the snapshot as CRLF.
# The rules above would then convert the same file to LF on checkout, which
# made `git diff --exit-code HEAD` report the whole tree as modified and failed
# the mirror. It would also break the SHA-256 values recorded in the
# generator's own `dataset_manifest.json`, since those digests are over the
# submodule's bytes. Leave every path under `external/` unconverted.
external/** -text
